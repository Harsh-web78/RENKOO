# .env.example — placeholders only. Copy to .env and fill locally.
# See docs/backend-architecture.md §18.7, §20.1 and §20.4.
# Do NOT commit real secrets. .env is gitignored.

# --- Core (required for Prompt 6 scaffold) ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://renko:renko@localhost:5432/renko
REDIS_URL=redis://localhost:6379
FRONTEND_URL=http://localhost:3001

# --- Prompt 8: Google OAuth (placeholders — do NOT add real credentials) ---
# Generate GOOGLE_TOKEN_ENCRYPTION_KEY with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Example placeholder key (32 zero bytes): AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# For dev you may leave GOOGLE_CLIENT_ID empty — OAuth will return 500 OAUTH_NOT_CONFIGURED until set
GOOGLE_CLIENT_ID=placeholder-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=placeholder-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
GSC_MOCK=true

# --- Prompt 13: frontend real provider (placeholders) ---
# NEXT_PUBLIC_API_BASE=http://localhost:3000/api/v1
# NEXT_PUBLIC_USE_REAL_PROVIDER=false
# Set NEXT_PUBLIC_USE_REAL_PROVIDER=true to wire the frontend to the real
# NestJS backend via lib/data-contract/api-provider.ts. Default (unset/false)
# keeps the deterministic mock provider. Never put tokens here.

# --- Added before production (§20.4) ---
# SESSION_SECRET=replace-with-strong-random-32B-base64
# CSRF_SECRET=replace-with-strong-random-32B-base64
